NODE_ENV=development
PORT=3100
HOST=0.0.0.0                 # inside the container; compose maps it to 127.0.0.1 on the host
DATABASE_URL=postgres://sylvan:change-me@db:5432/sylvan
DB_PASSWORD=change-me
DEVICE_KEY=generate-with-openssl-rand-hex-32
PHOTO_DIR=/data/photos
MAX_PHOTO_BYTES=500000
PUBLIC_BASE_URL=http://localhost:3100
DISPLAY_TIMEZONE=Asia/Dhaka   # default timezone for daily stats and CSV local times

# Optional
# SERVE_PHOTOS=true          # serve /photos from Node; defaults to true only when NODE_ENV=development
# TRUST_PROXY=127.0.0.1,::1  # proxy addresses whose X-Forwarded-* headers are trusted
# LOG_LEVEL=info

# Host-side development (npm run dev / npm test / npm run db:seed) runs outside
# Docker. Put these overrides in .env.local (git-ignored); it is read before .env.
# Start the database with `npm run db:up` first, which publishes it on 127.0.0.1:5433.
#   HOST=127.0.0.1
#   DATABASE_URL=postgres://sylvan:<DB_PASSWORD>@127.0.0.1:5433/sylvan
#   PHOTO_DIR=./data/photos
