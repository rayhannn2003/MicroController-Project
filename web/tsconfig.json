{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "sourceMap": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "vite.config.ts", "vitest.setup.ts"],
  "references": [{ "path": "../shared" }]
}
